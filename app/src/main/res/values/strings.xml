    <!-- Onboarding -->
    <string name="ob_next">Continue</string>
    <string name="ob_skip">Skip for now</string>
    <string name="ob_welcome_title">Welcome to ReelGuard</string>
    <string name="ob_welcome_body">ReelGuard counts how many Instagram Reels and YouTube Shorts you watch each day, lets you set a limit, and blocks Reels/Shorts when you reach it. Regular videos, your feed, stories and messages are never blocked.</string>
    <string name="ob_disclosure_title">What ReelGuard accesses</string>
    <string name="ob_disclosure_body">ReelGuard uses Android\'s Accessibility Service only to detect whether Reels or Shorts is on screen and to count swipes.\n\nIt does not read, collect or store content such as videos, captions, usernames or messages. Nothing is sent anywhere: all data stays on this device, and there is no account or analytics.</string>
    <string name="ob_agree">I understand, continue</string>
    <string name="ob_decline">No thanks</string>
    <string name="ob_declined">ReelGuard cannot work without this permission. You can change your mind at any time.</string>
    <string name="ob_enable_title">Turn on the accessibility service</string>
    <string name="ob_enable_body">Open Accessibility settings, choose ReelGuard (it may be under Installed apps), and switch it on.</string>
    <string name="ob_enabled">Service is on</string>
    <string name="ob_not_enabled">Service is not on yet</string>
    <string name="ob_open_settings">Open accessibility settings</string>
    <string name="ob_restricted_hint">If the switch is greyed out on Android 13+: open the ReelGuard entry in system App info, tap the menu, and choose Allow restricted settings.</string>
    <string name="ob_done_title">All set</string>
    <string name="ob_done_body">Your daily limit starts at 50 combined. You can change it in Settings.</string>
    <string name="ob_finish">Start</string>

