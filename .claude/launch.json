{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "remotion-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "promo-video", "run", "dev", "--", "--no-open", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "site",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "http-server", "site", "-p", "8080", "-c-1", "--silent"],
      "port": 8080
    }
  ]
}
